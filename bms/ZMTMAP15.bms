ZMTMAP15 TITLE 'ZMTMAP15 SCREEN LAYOUT'                                 00000010
         PRINT NOGEN                                                    00000020
ZMTMAP15 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000030
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000040
ZMTMAP1I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custoX00000060
               mer number and press Enter to continue'                  00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000080
           
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000100
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000110
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000120
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000130
         DFHMSD TYPE=FINAL                                              00000140
         END                                                            00000150
