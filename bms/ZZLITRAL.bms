ZZLITRAL DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZZLITRAI DFHMDI SIZE=(24,80)
THREEREC DFHMDF POS=(1,1),LENGTH=79,ATTRB=(PROT),INITIAL='AAA BBB      X
               CCC DDD                                                 X
               EEE'
LEADBLNK DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT),INITIAL='TOTAL:       X
                1.234,56'
SHORTPAD DFHMDF POS=(5,1),LENGTH=40,ATTRB=(PROT),INITIAL='LEFT         X
               RIGHT'
         DFHMSD TYPE=FINAL
         END
