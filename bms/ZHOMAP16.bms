ZHOMAP16 TITLE 'ZHOMAP16 SCREEN LAYOUT'                                 00000010
         PRINT NOGEN
ZHOMAP16 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000030
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000040
ZHOMAP1I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000060
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000120
         DFHMSD TYPE=FINAL                                              00000130
         END                                                            00000140
