ZZAMPERS DFHMSD TYPE=&SYSPARM,MODE=INOUT,CTRL=(FREEKB,FRSET),          X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZZAMPERI DFHMDI SIZE=(24,80)
AMPLIT   DFHMDF POS=(1,1),LENGTH=30,ATTRB=(PROT),                      X
               INITIAL='PROFIT && LOSS ACCOUNT'
VARSYM   DFHMDF POS=(3,1),LENGTH=10,ATTRB=(UNPROT)
         DFHMSD TYPE=FINAL
         END
