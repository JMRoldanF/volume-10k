ZZDAMAGE DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X

               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZZDAMAGI DFHMDI SIZE=(24,80)
TABBED	DFHMDF	POS=(1,1),LENGTH=20,ATTRB=(PROT)
LATERES  DFHMDF POS=(3,1),LENGTH=10,                                   X
                  ATTRB=(UNPROT)
         DFHMSD TYPE=FINAL
         END
