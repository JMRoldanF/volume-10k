***********************************************************************
* ZCUMAP07 -- generated volume-test mapset
***********************************************************************
         PRINT NOGEN
ZCUMAP07 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZCUMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='POLICY DETAILX
                Page 1 of 1'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
          
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZCUMAP07 DFHMSD TYPE=FINAL
         END
