*********************************************************************** 00000010
* ZPAMAP02 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZPAMAP02 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         SPACE 3
ZPAMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX
                the previous screen, PF3 to exit'                       00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000130

ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
         DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
