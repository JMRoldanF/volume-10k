ZHOMAP14 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   100000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
ZHOMAP1I DFHMDI SIZE=(24,80)                                            00000030
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custo100000040
               mer number and press Enter to continue'                  00000050
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000060
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000070
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000080
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000090
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000100
         DFHMSD TYPE=FINAL                                              00000110
         END                                                            00000120
