ZZDIRECT TITLE 'ZZDIRECT -- HLASM DIRECTIVES IN A BMS MAPSET'
         PRINT NOGEN
         SPACE 2
         COPY  ZZSTDAT
         EJECT
MAPBASE  EQU   *
ATTRPROT EQU   X'40'
MAPNEXT  EQU   *+4
STDBRT   EQU   ATTRBRT
ZZDIRECT DFHMSD TYPE=MAP,MODE=INOUT,TERM=3270-2,                       X
               CTRL=(FREEKB,FRSET),LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZZDIRECI DFHMDI SIZE=(24,80)
HDRTTL   DFHMDF POS=(1,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZZDIRECT DFHMSD TYPE=FINAL
         END
