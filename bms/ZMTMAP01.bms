ZMTMAP01 TITLE 'ZMTMAP01 SCREEN LAYOUT'                                 00000010

ZMTMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000030
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000040
ZMTMAP0I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000060
                the previous screen, PF3 to exit'                       00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000080
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000090
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000120
ZMTMAP01 DFHMSD TYPE=FINAL                                              00000130
         END                                                            00000140
