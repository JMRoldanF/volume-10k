         PRINT NOGEN                                                    00000010
ZREMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   *
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
         SPACE 1
ZREMAP0I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLI*00000060
               CY ENQUIRY -- ALL AMOUNTS IN GBP'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000090
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZREMAP01 DFHMSD TYPE=FINAL
         END
