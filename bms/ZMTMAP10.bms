*********************************************************************** 00000010
* ZMTMAP10 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZMTMAP10 TITLE 'ZMTMAP10 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN                                                    00000050
ZMTMAP10 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
ZMTMAP1I DFHMDI SIZE=(24,80)                                            00000080
         
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOLX00000100
               UME TEST'                                                00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000150
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000160
         DFHMSD TYPE=FINAL                                              00000170
         END                                                            00000180
