ZENMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   *00000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
         EJECT                                                          00000030
ZENMAP0I DFHMDI SIZE=(24,80)                                            00000040
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOL*00000050
               UME TEST'                                                00000060
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000070
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000080
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000090
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000100
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000110
         DFHMSD TYPE=FINAL                                              00000120
         END                                                            00000130
