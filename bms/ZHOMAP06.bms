***********************************************************************
* ZHOMAP06 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZHOMAP06 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT                                                          00000060
ZHOMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line
         DFHMSD TYPE=FINAL
         END                                                            00000160
