                  EXEC CICS READNEXT FILE('KSDSUW94')
                            INTO(KSDSUW94-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
                  END-EXEC
               END-PERFORM.
               EXEC CICS ENDBR FILE('KSDSUW94') END-EXEC.
