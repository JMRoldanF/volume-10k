                  END-IF
               END-PERFORM.
      *----------------------------------------------------------------*
       SQL-ACCESS-0069.
               EXEC SQL
                     DECLARE C0069 CURSOR FOR
                     SELECT POLICYNUMBER, PAYMENT
                       FROM GENAUW.PREMIUM A
                       JOIN GENAUW.CUSTOMER B
