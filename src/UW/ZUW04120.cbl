                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGRC')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZUW07810-001.
               PERFORM CALL-ZUW08330-002.
               PERFORM CALL-ZEN09997-003.
               PERFORM APPLY-BROKER-ID-0001.
               PERFORM DERIVE-POSTCODE-0002.
               PERFORM SQL-ACCESS-0003.
               PERFORM RECONCILE-TAX-BAND-0004.
               PERFORM SQL-ACCESS-0006.
               PERFORM AUDIT-PREMIUM-0007.
               PERFORM EXPAND-MODEL-0008.
               PERFORM SQL-ACCESS-0009.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZUW07810-001.
               MOVE 'ZUW07810' TO WS-SUBNAME-2
               CALL WS-SUBNAME-2 USING DFHCOMMAREA
                         WS-STATUS-CODE.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZUW07810 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZUW08330-002.
               CALL 'ZUW08330' USING DFHCOMMAREA
                         WS-STATUS-CODE.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZUW08330 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
