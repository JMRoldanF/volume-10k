               EXEC CICS READ FILE('KSDSCU82')
                         INTO(KSDSCU82-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
