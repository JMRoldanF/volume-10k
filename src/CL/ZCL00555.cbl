                         MAPSET('ZCLMAP06')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZCLMAP0I')
                         MAPSET('ZCLMAP06')
                         RESP(WS-RESP)
               END-EXEC.
