       FILE-ACCESS-0012.
               EXEC CICS WRITE FILE('KSDSPA87')
                         FROM(KSDSPA87-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
