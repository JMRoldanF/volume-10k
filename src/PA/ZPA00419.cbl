                         MAPSET('ZPAMAP05')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZPAMAP0I')
                         MAPSET('ZPAMAP05')
                         RESP(WS-RESP)
               END-EXEC.
