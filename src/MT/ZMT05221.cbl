       FILE-ACCESS-0099.
               EXEC CICS WRITE FILE('KSDSMT84')
                         FROM(KSDSMT84-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
