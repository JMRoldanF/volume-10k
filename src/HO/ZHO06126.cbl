               EXEC CICS STARTBR FILE('KSDSHO75')
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               PERFORM UNTIL WS-RESP NOT = DFHRESP(NORMAL)
                  EXEC CICS READNEXT FILE('KSDSHO75')
                            INTO(KSDSHO75-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
